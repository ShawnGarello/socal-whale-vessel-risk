{
  "name": "socal-whale-vessel-risk-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && npm run typecheck:generated",
    "typecheck:generated": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:clean": "npm ci && npm run typegen && npm run format:check && npm run lint && npm run typecheck:generated && npm test && npm run build"
  },
  "dependencies": {
    "@arcgis/core": "^5.1.20",
    "@arcgis/map-components": "^5.1.20",
    "@esri/calcite-components": "^5.1.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "Web application for the SoCal whale-vessel spatial overlap analysis",
  "engines": {
    "node": ">=20.9.0"
  }
}
