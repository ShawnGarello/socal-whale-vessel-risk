# Environment variable NAMES only. Never put a real value in this file.
#
# Copy to `.env.local` (Git-ignored) and fill in locally. In deployment these
# are set in the hosting platform's environment settings, not in the repository.
#
# Every `NEXT_PUBLIC_` variable is inlined into the JavaScript bundle at build
# time and is therefore PUBLIC. Treat any value below as readable by anyone who
# loads the site.

# ArcGIS API key used by the browser to request the basemap.
#
# Because it is public it MUST be:
#   - restricted to the deployed origin(s) via the credential's referrer URLs,
#     plus http://localhost:3000 for local development;
#   - scoped to the minimum privileges the application needs (basemap styles,
#     and later read access to the project's public hosted layers);
#   - WITHOUT any publishing, content-management, or account-management
#     privilege. Publishing to ArcGIS Online is a separate, authenticated,
#     author-run operation and never uses this key.
#
# Rotate it if it is ever committed or pasted anywhere shared.
NEXT_PUBLIC_ARCGIS_API_KEY=

# Optional. Basemap style id for the initial map. Defaults to "arcgis/oceans"
# when unset. See the ArcGIS basemap styles service for valid ids.
NEXT_PUBLIC_ARCGIS_BASEMAP=

# Optional. URL the browser fetches the project's modeled blue-whale density
# GeoJSON from. Defaults to "/layers/blue-whale-density.geojson", the
# same-origin path the display exporter stages into for local development and
# for the static export.
#
# Set this for a release that publishes a checksum-addressed filename, so an
# immutable artifact URL is never confused with a mutable one. It is inlined at
# build time, so changing it requires a rebuild.
NEXT_PUBLIC_WHALE_LAYER_URL=

# Optional same-origin or checksum-addressed URLs for the deterministic vessel
# activity and accepted analytical-domain GeoJSON exports. The local defaults
# are "/layers/commercial-vessel-activity.geojson" and
# "/layers/accepted-analytical-domain.geojson". Changing either requires a
# rebuild; the configured bytes must match the checksums bound in the source.
NEXT_PUBLIC_VESSEL_LAYER_URL=
NEXT_PUBLIC_DOMAIN_LAYER_URL=
